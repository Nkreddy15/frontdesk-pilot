# Copy to .env and set server-side values. Never commit actual credentials.
NODE_ENV=development
USE_PGLITE=false
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
PUBLIC_API_URL=
DATABASE_URL=postgresql://receptionist_app:CHANGE_ME@127.0.0.1:5432/receptionist
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/receptionist
DATABASE_SSL=false
DEV_AUTH_ENABLED=false
DEV_AUTH_TOKEN=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
HUMAN_TRANSFER_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Live services stay disabled until business setup, consent, and smoke tests pass.
LIVE_VOICE_ENABLED=false
SMS_ENABLED=false
CALENDAR_ENABLED=false
RECORDING_ENABLED=false
WORKER_TENANT_IDS=
MAX_CONCURRENT_CALLS=5
MAX_CALL_MINUTES=8
MONTHLY_MINUTE_LIMIT=300

# Staging: comma-separated founder phone numbers; blank only after live approval.
VOICE_TEST_CALLER_ALLOWLIST=

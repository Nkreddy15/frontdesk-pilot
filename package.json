{
  "name": "receptionist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "setup:local": "node scripts/local-db.mjs setup && node --import tsx scripts/migrate.ts && node --import tsx scripts/seed.ts",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --import tsx apps/api/src/server.ts",
    "dev:dashboard": "npm run dev -w @receptionist/dashboard",
    "dev:worker": "node --watch --import tsx apps/worker/src/main.ts",
    "start:api": "node --import tsx apps/api/src/server.ts",
    "start:worker": "node --import tsx apps/worker/src/main.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w @receptionist/dashboard",
    "test": "node scripts/test.mjs",
    "test:concurrency": "node scripts/test.mjs tests/concurrency.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "build": "npm run build -w @receptionist/dashboard",
    "check:readiness": "node --import tsx scripts/readiness.ts",
    "setup:wasm": "node --import tsx scripts/setup-wasm.ts && node --import tsx scripts/seed.ts",
    "setup:docker": "node scripts/setup-docker.mjs && node --import tsx scripts/migrate.ts && node --import tsx scripts/seed.ts",
    "start:dashboard": "node scripts/start-dashboard.mjs",
    "provision:pilot": "node --import tsx scripts/provision-pilot.ts",
    "test:http": "node scripts/http-smoke.mjs",
    "contracts": "node --import tsx scripts/export-contracts.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" package.json",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" package.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "5.12.5",
    "jose": "^6.1.3",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "tsx": "^4.21.0",
    "twilio": "^5.10.4",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17"
  }
}
